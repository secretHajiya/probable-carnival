rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // All profile creation/updates are performed by trusted Cloud Functions.
      allow create, update, delete: if false;
    }

    match /proofs/{proofId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId','offerName','reward','code','createdAt','status','interstitialShown'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.offerName is string
        && request.resource.data.reward is int
        && request.resource.data.reward >= 0
        && request.resource.data.code is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('interstitialShown' in request.resource.data) || request.resource.data.interstitialShown is bool);
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Withdrawal creation and balance changes must go through Cloud Functions.
    match /withdrawals/{withdrawalId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
